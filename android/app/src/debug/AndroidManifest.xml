<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <application>
        <!-- Debug only: event dump for the spikes. Exported so adb can trigger it. -->
        <receiver android:name=".host.DebugTools" android:exported="true">
            <intent-filter>
                <action android:name="com.kleos.sakshi.DUMP_EVENTS" />
                <action android:name="com.kleos.sakshi.RUN_INGEST_NOW" />
                <action android:name="com.kleos.sakshi.SET_LAKE_STATE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
