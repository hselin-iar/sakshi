<?xml version="1.0" encoding="utf-8"?>
<!-- A flat tile for launchers older than Android 12, which show an image rather than the preview layout. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF653618" />
            <corners android:radius="16dp" />
            <size android:width="220dp" android:height="80dp" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/lake_rippled"
        android:gravity="center"
        android:width="112dp"
        android:height="56dp" />
</layer-list>
