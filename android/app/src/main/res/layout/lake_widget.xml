<?xml version="1.0" encoding="utf-8"?>
<!-- Translucent backing with light text so it reads on any wallpaper, light or dark. No counters, no minutes. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lake_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CC1B2B34"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <ImageView
        android:id="@+id/lake_image"
        android:layout_width="56dp"
        android:layout_height="40dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/lake_phrase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#F2F6F8"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/lake_as_of"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#B9C6CD"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
