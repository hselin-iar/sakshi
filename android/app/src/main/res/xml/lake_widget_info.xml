<?xml version="1.0" encoding="utf-8"?>
<!-- The Lake widget (LC-9). No timer: it redraws only when a window finishes, on app open, and when the system asks. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="40dp"
    android:targetCellWidth="2"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:resizeMode="none"
    android:widgetCategory="home_screen"
    android:description="@string/lake_widget_description"
    android:previewImage="@drawable/lake_widget_preview"
    android:previewLayout="@layout/lake_widget_preview"
    android:initialLayout="@layout/lake_widget" />
